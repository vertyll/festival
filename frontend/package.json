{
  "name": "festival-frontend",
  "private": true,
  "description": "Sunset Festival – front-end",
  "author": "Mikołaj Gawron gawrmiko@gmail.com",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:page": "turbo dev --filter=@festival/page",
    "dev:admin": "turbo dev --filter=@festival/admin",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:translations": "node scripts/check-translations.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "use-intl": "4.14.7"
  }
}
