{
  "realm": "festival",
  "enabled": true,
  "displayName": "Sunset Festival",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(8) and notEmail and notUsername",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pl",
    "en"
  ],
  "defaultLocale": "pl",
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false
      },
      {
        "name": "USER",
        "description": "Standard user role",
        "composite": false
      },
      {
        "name": "ADMIN",
        "description": "Administrator role: signs in to the festival admin panel",
        "composite": false
      },
      {
        "name": "default-roles-festival",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "USER"
          ],
          "client": {
            "account": [
              "manage-account",
              "view-profile"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-festival",
    "composite": true,
    "clientRole": false
  },
  "smtpServer": {
    "host": "maildev",
    "port": "1025",
    "from": "noreply@festival.local",
    "fromDisplayName": "Sunset Festival",
    "auth": "false",
    "starttls": "false",
    "ssl": "false"
  },
